<header id="top-header">
  <span class="siteName">
    <a href="/" title="return to home page">
      CSE Motors
    </a>
  </span>

  <div id="tools">

    <% if (locals.loggedin) { %>
      <!-- <span>Welcome <%= locals.accountData.account_firstname %></span> -->
      <a href="/account/" title="Account Management">
        Welcome <%= locals.accountData.account_firstname %>
      </a>
      |
      <a href="/account/logout" title="Log out">Logout</a>

      <% } else { %>
        <a href="/account/login" title="Click to log in">
          My Account
        </a>
        <% } %>

  </div>
</header>