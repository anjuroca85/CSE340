<!-- This is my views/inventory/detail.ejs -->
<%# Main content heading for the page (required) %>
<% if (title) { %>
    <h1><%= title %></h1>
<% } else { %>
    <h1>Vehicle Detail</h1>
<% } %>

<%# Vehicle detail HTML generated by utilities.buildDetailView() %>
<%- vehicleDetail %>

<% if (locals.loggedin) { %>
    <% if (!isFavorite) { %>
        <form action="/account/favorites/add" method="post">
            <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
            <button type="submit">Save to Favorites</button>
        </form>
        <% } else { %>
            <form action="/account/favorites/remove" method="post">
                <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
                <button type="submit">Remove from Favorites</button>
            </form>
        <% } %>
<% } %>