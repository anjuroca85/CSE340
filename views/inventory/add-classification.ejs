<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
<% } %>

<%- messages() %>
<% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error=> { %>
            <li>
                <%= error.msg %>
            </li>
        <% }) %>
    </ul>
<% } %>
<form class="inv-form" action="/inv/add-classification" method="post">
    <fieldset>
        <legend>New Classification</legend>
        <label for="classification_name">Classification Name</label><br>
        <span class="form-hint">Name must be alphabetic characters ONLY.</span>
        <input type="text" id="classification_name" name="classification_name" required
            pattern="^[A-Za-z0-9]+$"
            title="Use only letters and numbers. No spaces or special characters."
            value="<%= typeof classification_name !== 'undefined' ? classification_name : '' %>">
        <button type="submit">Add Classification</button>
    </fieldset>
</form>