<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
<% } else { %>
    <h1>
        Add Inventory Item
    </h1>
<% } %>



<%- messages() %>

<% if (errors) { %>
    <ul class="notice">
        <% errors.array().forEach(error=> { %>
            <li>
                <%= error.msg %>
            </li>
        <% }) %>
    </ul>
<% } %>
<form class="inv-form" action="/inv/add-inventory" method="post">
    <fieldset>
        <legend>Vehicle Information</legend>

        <div class="form-grid">
            <div class="span-2">
                <label for="classificationList">Classification</label>
                <%- classificationList %>
            </div>

            <div>
                <label for="inv_make">Make</label>
                <input id="inv_make" name="inv_make" required value="<%= locals.inv_make || '' %>">
            </div>

            <div>
                <label for="inv_model">Model</label>
                <input id="inv_model" name="inv_model" required value="<%= locals.inv_model || '' %>">
            </div>

            <div>
                <label for="inv_year">Year</label>
                <input id="inv_year" name="inv_year" type="number" required value="<%= locals.inv_year || '' %>">
            </div>

            <div class="span-4">
                <label for="inv_description">Description</label>
                <textarea id="inv_description" name="inv_description"
                    required><%= locals.inv_description || '' %></textarea>
            </div>

            <input type="hidden" name="inv_image" value="/images/vehicles/no-image.png">
            <input type="hidden" name="inv_thumbnail" value="/images/vehicles/no-image-tn.png">

            <div>
                <label for="inv_price">Price</label>
                <input id="inv_price" name="inv_price" type="number" step="0.01" required
                    value="<%= locals.inv_price || '' %>">
            </div>

            <div>
                <label for="inv_miles">Miles</label>
                <input id="inv_miles" name="inv_miles" type="number" required value="<%= locals.inv_miles || '' %>">
            </div>

            <div>
                <label for="inv_color">Color</label>
                <input id="inv_color" name="inv_color" required value="<%= locals.inv_color || '' %>">
            </div>

            <div class="span-4">
                <button type="submit">Add Inventory Item</button>
            </div>
        </div>
    </fieldset>
</form>